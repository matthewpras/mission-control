# Kalshi API Credentials
# Get these from https://kalshi.com/account/details (Developer section)

# Your Access Key ID (Public)
KALSHI_KEY_ID=paste_your_key_id_here

# Path to your private key file (relative to project root or absolute)
# Recommended: Place the .pem file in projects/kalshi-oracle/keys/
KALSHI_PRIVATE_KEY_PATH=projects/kalshi-oracle/keys/kalshi.pem

# Environment: "demo" (Paper Trading) or "prod" (Real Money)
KALSHI_ENV=demo
